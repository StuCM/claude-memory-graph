# The name your server is reached at (an A/AAAA record pointing at this machine).
DOMAIN=memory.example.com
# Same address with https:// — turns on sign-in for claude.ai and the phone/desktop apps.
MEMORY_GRAPH_PUBLIC_URL=https://memory.example.com
# Long and random: openssl rand -hex 32. Goes into each Claude Code machine's plugin settings.
MEMORY_GRAPH_TOKEN=
# What you type on the sign-in page when you connect an app. Something you can type on a phone.
MEMORY_GRAPH_PASSWORD=
